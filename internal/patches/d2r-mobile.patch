+    MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction = [lib newFunctionWithName:@"ambient_vs"]; pd.fragmentFunction = [lib newFunctionWithName:@"ambient_fs"];
+    pd.colorAttachments[0].pixelFormat = format;
+    g_ambient_pso = [g_dev newRenderPipelineStateWithDescriptor:pd error:&e];
+    if (!g_ambient_pso) MDIE("黑边光效管线失败 %s", e.localizedDescription.UTF8String);
+    g_ambient_fmt = format;
+}
+// Metal 3 光照图：u->light[0] 是混合权重；clear = 1 时先清零（权重须为 1）。 | Metal 3 light map: u->light[0] is the blend weight; clear = 1 clears it first (the weight must be 1).
+static void ambient_map_m3(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> map, const ambient_uniforms *u, int clear) {
+    MTLRenderPassDescriptor *rp = [MTLRenderPassDescriptor renderPassDescriptor];
