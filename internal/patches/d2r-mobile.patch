+static void sparse_tile_layout(const nvn_texdesc *desc, NVNtextureSparseTileLayout *out) {
+    memset(out, 0, sizeof(*out));
+    if (!(desc->flags & NVN_TEXTURE_FLAGS_SPARSE)) return;
+    nvn_texdesc d = *desc;
+    d.pkg_block_h = d.pkg_block_w = 0; /* SDK query ignores packaged layout overrides. */
+    nvn_texlayout L; nvn_tex_layout(&d, &L);
+    if (!L.size) die("Unsupported sparse texture %ux%ux%u target %d format %#x levels %u", d.width, d.height, d.depth, d.target, d.format, d.levels);
+    if (!L.tileW) return; /* Small textures occupy the block-linear mip tail. */
+    int bw, bh; nvn_fmt_bpb(d.format, &bw, &bh);
+    *out = (NVNtextureSparseTileLayout){1, (64u << L.tileW) / L.bpb * bw, (8u << L.tileH) * bh, 1};
+}
