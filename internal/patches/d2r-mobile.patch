+}
+static void ambient_draw_m3(id<MTLRenderCommandEncoder> en, id<MTLTexture> map, id<MTLTexture> dst, MTLViewport vp, const ambient_uniforms *u) {
+    MTLScissorRect bars[2];
+    int n = ambient_bar_rects(vp, dst.width, dst.height, bars);
+    [en setRenderPipelineState:g_ambient_pso];
