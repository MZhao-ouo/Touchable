+int mtl_copy_on_submit(uint64_t addr, uint64_t size) {
+    if (!addr || !size || size > 65536) return 0;
+    for (int i = 0; i < COS_MAX; i++) if (atomic_load(&g_cos_lo[i]) == addr) { atomic_store(&g_cos_hi[i], addr + size); return 1; }
+    for (int i = 0; i < COS_MAX; i++) { uint64_t none = 0; if (atomic_compare_exchange_strong(&g_cos_lo[i], &none, addr)) { atomic_store(&g_cos_hi[i], addr + size); return 1; } }
