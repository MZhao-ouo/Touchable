--- /dev/null
+++ b/dm/gfx/nvn/nvn_msl.h
@@ -0,0 +1,15 @@
+// nvn_msl.h —— 运行时现编 MSL 的编译选项
+// 语言版本固定为最老受支持系统（iOS 26 / macOS 26）的 Metal 4.0：新系统或新 SDK 上也照这个版本编，
+// 所以 Mac 宿主和新设备上能编过的源码，在 iOS 26 上同样能编过。改最低系统时同步改这里。
+// nvn_msl.h - compile options for MSL compiled at runtime
+// The language version is pinned to Metal 4.0, the version of the oldest supported system (iOS 26 / macOS 26). Newer systems and SDKs compile with
+// the same version, so a source that compiles on the Mac host or a newer device also compiles on iOS 26. Change this together with the minimum system.
+#pragma once
+#import <Metal/Metal.h>
+
+static inline MTLCompileOptions *nvn_msl_options(void) {
+    static MTLCompileOptions *options;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ options = [MTLCompileOptions new]; options.languageVersion = MTLLanguageVersion4_0; });
+    return options;
+}
