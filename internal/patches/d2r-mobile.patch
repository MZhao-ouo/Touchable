+        "  float d = horiz ? (first ? r.y - px.y : px.y - r.y - r.w) : (first ? r.x - px.x : px.x - r.x - r.z);\n"
+        "  float bar = horiz ? (first ? r.y : size.y - r.y - r.w) : (first ? r.x : size.x - r.x - r.z);\n"
+        "  float span = horiz ? r.z : r.w;\n"
