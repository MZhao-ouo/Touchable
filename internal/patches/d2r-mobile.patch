+    u->params[0] = (float)dw; u->params[1] = (float)dh;
+    u->params[2] = vp.originY > 0.5 ? 0.0f : 1.0f;   // 0 = 上下黑边，1 = 左右黑边 | 0 = top/bottom, 1 = left/right
