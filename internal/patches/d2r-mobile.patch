-          void, h_nv_SetDevAlloc, nv_alloc_fn a, nv_free_fn f, nv_realloc_fn r, void *u) { g_nv_devtools_alloc = (struct nv_allocator){a, f, r, u}; }
+// 分配器除了记进宿主副本，还要转调客体 sdk 里的原实现：媒体栈（subsdk0 的电影 / NVOMX → sdk 的 NvOs / NvRm）
+// 按 sdk 内全局分配器做 nvos 分配，只记宿主副本会让它在 NvRmChannelOpen 里断言
+// "ERROR: SetGraphicsAllocator must be called prior to Alloc"（nvos_hos.cpp），整个进程退出。
+// 原实现只把四个回调写进 sdk 的全局变量并装默认实现，直接调用安全。
+// Besides the host copy, forward the call to the real implementation in the guest sdk: the media stack
+// (subsdk0's movie / NVOMX -> sdk's NvOs / NvRm) allocates nvos memory through the sdk-global allocator, and a host copy
+// alone makes it assert "ERROR: SetGraphicsAllocator must be called prior to Alloc" (nvos_hos.cpp), exiting the process.
+// The real implementation only stores the four callbacks in sdk globals and installs defaults, so calling it is safe.
+typedef void (*nv_set_alloc_fn)(nv_alloc_fn, nv_free_fn, nv_realloc_fn, void *);
+static nv_set_alloc_fn nv_guest_set_alloc[2];
+static void nv_forward_set_alloc(int which, const char *mangled, nv_alloc_fn a, nv_free_fn f, nv_realloc_fn r, void *u) {
+    nv_set_alloc_fn *slot = &nv_guest_set_alloc[which];
+    if (!*slot) {
+        *slot = (nv_set_alloc_fn)guest_sym(mangled);
+        if (!*slot) { LOG("【红】客体 sdk 里找不到 %s：媒体栈的 nvos 分配拿不到分配器", mangled); return; }
+    }
+    (*slot)(a, f, r, u);
+}
+HLE_FORCE("_ZN2nv20SetGraphicsAllocatorEPFPvmmS0_EPFvS0_S0_EPFS0_S0_mS0_ES0_", WHY "；分配器记入 g_nv_alloc，并转调客体原实现",
+          void, h_nv_SetAlloc, nv_alloc_fn a, nv_free_fn f, nv_realloc_fn r, void *u) {
+    nv_forward_set_alloc(0, "_ZN2nv20SetGraphicsAllocatorEPFPvmmS0_EPFvS0_S0_EPFS0_S0_mS0_ES0_", a, f, r, u);
+    g_nv_alloc = (struct nv_allocator){a, f, r, u};
+}
+HLE_FORCE("_ZN2nv28SetGraphicsDevtoolsAllocatorEPFPvmmS0_EPFvS0_S0_EPFS0_S0_mS0_ES0_", WHY "；分配器记入 g_nv_devtools_alloc，并转调客体原实现",
+          void, h_nv_SetDevAlloc, nv_alloc_fn a, nv_free_fn f, nv_realloc_fn r, void *u) {
+    nv_forward_set_alloc(1, "_ZN2nv28SetGraphicsDevtoolsAllocatorEPFPvmmS0_EPFvS0_S0_EPFS0_S0_mS0_ES0_", a, f, r, u);
+    g_nv_devtools_alloc = (struct nv_allocator){a, f, r, u};
+}
 HLE_FORCE("_ZN2nv18InitializeGraphicsEPvm", WHY, void, h_nv_Init, void *mem, unsigned long size) { (void)mem; (void)size; }
 HLE_FORCE("_ZN2nv16FinalizeGraphicsEv", WHY, void, h_nv_Fin, void) {}
+
+// 媒体栈（电影解码）在 subsdk0 里，走真驱动：大片的 NvOs/NvRm 调用在宿主没有 nvdrv 硬件驱动可用。
+// NvMMLiteOpenVideo 先开 NvRm 通道；调用点把非 0 返回当「失败」走错误路径（打印并返回错误码），
+// 所以这里回失败让解码器干净地报错退出，而不是让 SDK 在 InitCheck / 空驱动对象上中止整个进程。
+// The media stack (movie decode) lives in subsdk0 and uses the real driver: its many NvOs/NvRm calls have no nvdrv
+// backing on the host. NvMMLiteOpenVideo first opens an NvRm channel, and the call site treats a non-zero return as
+// failure (logs it and returns an error code), so failing here lets the decoder exit with a clean error instead of the
+// SDK aborting the whole process in InitCheck or on the null driver object.
+HLE_FORCE("NvRmChannelOpen", "宿主没有 nvdrv 的 NvRm 通道：媒体栈按失败处理，别让它走到 SDK 中止",
+          int, h_nvrm_channel_open, void *a, void *b, int c, void *d) {
+    static int once;
+    if (!once++) LOG("NvRmChannelOpen：宿主无 nvdrv，报失败（媒体/电影解码不可用）%p %p %d %p", a, b, c, d);
+    return 1;
+}
+
+// 媒体栈的清理路径无条件销毁它自己建的信号量（subsdk0 0x7a8dc 起：ldr x0,[ctx+#..] 后直接 bl NvOsSemaphoreDestroy）。
+// 真机上这些信号量必定建成；本移植在开 NvRm 通道时就失败，后面的信号量没建成，指针是空，客体实现 NvOsSemaphoreDestroy
+// （sdk 0x462fc0）不做空判断，直接进 nn::os::FinalizeSemaphore，在 [NULL+0x10] 上崩。同模块的 NvOsSemaphoreDestroyEx
+// 就是它的空安全版：空指针返回 4、其余与 Destroy 相同。整条接管 NvOsSemaphoreDestroy 并转调 DestroyEx，非空行为不变。
+// The media stack's clean-up path destroys its own semaphores unconditionally (subsdk0 from 0x7a8dc: ldr x0,[ctx+#..] then
+// bl NvOsSemaphoreDestroy directly). On real hardware those semaphores always exist; this port fails at the NvRm channel
+// open, so the later semaphores were never created, the pointer is null, and the guest implementation NvOsSemaphoreDestroy
+// (sdk 0x462fc0) has no null check: it enters nn::os::FinalizeSemaphore and faults on [NULL+0x10]. The same module's
+// NvOsSemaphoreDestroyEx is its null-safe variant: it returns 4 for a null pointer and is otherwise identical to Destroy.
+// Take over NvOsSemaphoreDestroy entirely and forward to DestroyEx; the non-null behaviour is unchanged.
+HLE_FORCE("NvOsSemaphoreDestroy", "媒体栈错误路径会销毁未创建的信号量：转调客体同模块的空安全版 DestroyEx",
+          void, h_nvos_sem_destroy, void *s) {
+    static void (*destroy_ex)(void *);
+    if (!destroy_ex) {
+        destroy_ex = (void (*)(void *))guest_sym("NvOsSemaphoreDestroyEx");
+        if (!destroy_ex) { LOG("【红】客体 sdk 里找不到 NvOsSemaphoreDestroyEx"); return; }
+    }
+    destroy_ex(s);
+}
