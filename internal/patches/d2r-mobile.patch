index 0000000000000000000000000000000000000000..9cc86543fd6ca58c07255b08a3ec7bc918b8fbae
--- /dev/null
+++ b/dm/gfx/tests/t_clear_keep.m
@@ -0,0 +1,72 @@
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t g_mod[MAX_MOD]; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int fail, count;
+#define EXPECT(name, want, got) do { uint64_t w=(want), g=(got); count++; printf("%s 期望 %llu → 真结果 %llu %s\n", name, (unsigned long long)w, (unsigned long long)g, w==g?"✓":"✗"); fail += w != g; } while (0)
+typedef struct { uint8_t *p; size_t n; } chain;
+static chain chain_new(void) { chain c={0}; if (posix_memalign((void **)&c.p,getpagesize(),65536)) abort(); memset(c.p,0,65536); mtl_pool_add(c.p,65536); return c; }
+static void emit(chain *c, unsigned op, const void *a, size_t n) { size_t z=(8+n+7)&~7ull; op_hdr h={op,(uint32_t)z}; memcpy(c->p+c->n,&h,8); if(n) memcpy(c->p+c->n+8,a,n); c->n+=z; }
+static tex_t tex(unsigned w) { static uint64_t s=9500; tex_t t={.serial=s++}; t.d.width=t.d.height=w; t.d.depth=t.d.samples=1; t.d.levels=1; t.d.target=NVN_TEXTURE_TARGET_2D; t.d.format=NVN_FORMAT_RGBA8; return t; }
+static void set_rt(chain *c, const tex_t *a) { p_set_rt r={.n=1}; r.color[0]=a; emit(c,OP_SET_RT,&r,sizeof r); p_viewports v={.n=1};v.v[0][2]=v.v[0][3]=8;emit(c,OP_VIEWPORTS,&v,sizeof v);p_scissor sc={0,0,8,8};emit(c,OP_SCISSOR,&sc,sizeof sc); }
+static void clear_color(chain *c, float v) { p_clear_color x={.index=0,.mask=15,.rgba={v,v,v,1}}; emit(c,OP_CLEAR_COLOR,&x,sizeof x); }
+static void bind_prog(chain *c, prog_t *p) { p_bind_program b={p,3}; emit(c,OP_BIND_PROGRAM,&b,sizeof b); }
+static void draw_cmd(chain *c) { p_draw d={NVN_DRAW_PRIMITIVE_TRIANGLES,0,3}; emit(c,OP_DRAW,&d,sizeof d); }
+static void blend(chain *c) { color_st col={1,NVN_LOGIC_OP_COPY,NVN_ALPHA_FUNC_ALWAYS}; p_bind_state x={.kind=1};memcpy(x.bytes,&col,sizeof col);emit(c,OP_BIND_STATE,&x,sizeof x); blend_st b={0,NVN_BLEND_FUNC_SRC_ALPHA,NVN_BLEND_FUNC_ONE_MINUS_SRC_ALPHA,NVN_BLEND_FUNC_ONE,NVN_BLEND_FUNC_ZERO,NVN_BLEND_EQUATION_ADD,NVN_BLEND_EQUATION_ADD};x.kind=0;memcpy(x.bytes,&b,sizeof b);emit(c,OP_BIND_STATE,&x,sizeof x); }
+static void ds_off(chain *c) { ds_st d={0,0,NVN_DEPTH_FUNC_ALWAYS,0,NVN_STENCIL_FUNC_ALWAYS,NVN_STENCIL_FUNC_ALWAYS,NVN_STENCIL_OP_KEEP,NVN_STENCIL_OP_KEEP,NVN_STENCIL_OP_KEEP,NVN_STENCIL_OP_KEEP,NVN_STENCIL_OP_KEEP,NVN_STENCIL_OP_KEEP}; p_bind_state x={.kind=5}; memcpy(x.bytes,&d,sizeof d); emit(c,OP_BIND_STATE,&x,sizeof x); }
+static void readback(const tex_t *t0, const tex_t *t1, uint8_t out0[256], uint8_t out1[256]) {   /* both textures in one submission */
+    id<MTLBuffer> b=[g_dev newBufferWithLength:512 options:MTLResourceStorageModeShared]; const tex_t *ts[2]={t0,t1};
+    for (int i=0;i<2;i++) [blit() copyFromTexture:tex_mtl(ts[i]) sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(8,8,1) toBuffer:b destinationOffset:256*i destinationBytesPerRow:32 destinationBytesPerImage:256];
+    uint64_t f=mtl_sub_commit(); EXPECT("提交完成",1,mtl_wait(f,5000000000ull)); EXPECT("提交反馈无错误",0,mtl_last_commit_error()); memcpy(out0,b.contents,256); memcpy(out1,(uint8_t *)b.contents+256,256); }
+static NvProg *g_test_prog;   /* the program object stays alive for the whole test */
+static void setup_prog(prog_t *pg) { NSError *e=nil; id<MTLLibrary> l=[g_dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal; vertex float4 v(uint n[[vertex_id]]){float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)};return float4(p[n],0,1);}\nfragment float4 red(){return float4(1,0,0,0.5);}\n" options:nil error:&e]; if(!l){fprintf(stderr,"%s\n",e.localizedDescription.UTF8String);abort();} pg->serial=8500; NvProg *p=[NvProg new];p->sh[0]=[NvShader new];p->sh[0]->fn=[l newFunctionWithName:@"v"];p->sh[1]=[NvShader new];p->sh[1]->stage=1;p->sh[1]->fn=[l newFunctionWithName:@"red"]; g_test_prog=p; serial_put(pg->serial,p); }
+// 同目标续挂清除单测（生产 mtl_exec）：设 A → 清 A → 再设 A → 半透明红绘制，应与「设 A → 清 A → 绘制」逐字节相同且只开一个通道；
+// 中途改设另一目标 B 时，A 的清除必须单独落地。
+// Unit test for keeping pending clears on the same targets (production mtl_exec): set A -> clear A -> set A again -> half-transparent red draw must match
+// "set A -> clear A -> draw" byte for byte and open only one pass; when the targets change to B in between, the clear of A must still land on its own.
+// mode: 0 baseline (set A, clear, draw); 1 set A again before the draw; 2 set B before the draw (A keeps only its clear)
+static uint64_t run(int mode, uint8_t a_px[256], uint8_t b_px[256]) {
+    tex_t a=tex(8), b=tex(8); chain c=chain_new(); static prog_t pg; memset(&pg,0,sizeof pg); setup_prog(&pg);
+    set_rt(&c,&b); clear_color(&c,0.75f);   /* B starts as a known color in every mode */
+    set_rt(&c,&a); clear_color(&c,0.25f);
+    if (mode == 1) set_rt(&c,&a);
+    if (mode == 2) set_rt(&c,&b);
+    if (mode == 3) { int action=NVN_TILED_CACHE_ACTION_FLUSH;emit(&c,OP_TILED_CACHE,&action,sizeof action); }
+    ds_off(&c); blend(&c); bind_prog(&c,&pg); draw_cmd(&c); emit(&c,OP_END,NULL,0);
+    state_reset(); memset(&R,0,sizeof R); vis_clear(); g_vis_on=g_vis_counting=0;
+    uint64_t p0=g_stat_pass;
+    mtl_sub_begin(); uint64_t hh=(uint64_t)c.p; mtl_sub_index(&hh,1); mtl_exec(c.p);
+    uint64_t passes=g_stat_pass-p0; readback(&a,&b,a_px,b_px); return passes;
+}
+int main(void){@autoreleasepool{setvbuf(stdout,NULL,_IONBF,0);setenv("DM_NVN_TBDR","1",1);mtl_init();
+    uint8_t a0[256],b0[256],a1[256],b1[256],a2[256],b2[256];
+    uint64_t k0=g_clear_keep_n; uint64_t n0=run(0,a0,b0); EXPECT("基准：不续挂",0,g_clear_keep_n-k0);
+    uint64_t k1=g_clear_keep_n; uint64_t n1=run(1,a1,b1);
+    EXPECT("再设同一目标：续挂一次",1,g_clear_keep_n-k1);
+    EXPECT("再设同一目标：通道数与基准相同",n0,n1);
+    EXPECT("再设同一目标：A 与基准逐字节相同",0,(uint64_t)(memcmp(a0,a1,256)!=0));
+    EXPECT("再设同一目标：B 与基准逐字节相同",0,(uint64_t)(memcmp(b0,b1,256)!=0));
+    EXPECT("A 是清除色上叠半透明红（红 > 绿）",1,a1[0]>a1[1]+64);
+    uint64_t k2=g_clear_keep_n; uint64_t n2=run(2,a2,b2);
+    EXPECT("改设另一目标：不续挂",0,g_clear_keep_n-k2);
+    EXPECT("改设另一目标：A 的清除单独落地（多一个通道）",n0+1,n2);
+    EXPECT("改设另一目标：A 只有清除色（0.25 → 64）",64,a2[0]);
+    EXPECT("改设另一目标：A 的绿与红相同（没画红）",a2[0],a2[1]);
+    EXPECT("改设另一目标：B 被画上红（红 > 绿）",1,b2[0]>b2[1]+64);
+    uint8_t af[256],bf[256];uint64_t nf=run(3,af,bf);
+    EXPECT("tiled-cache flush lands pending clear before drawing",n0+1,nf);
+    EXPECT("tiled-cache flush preserves pixels",0,memcmp(a0,af,256)!=0);
+    setenv("DM_NVN_CLEAR_KEEP","0",1); g_clear_keep_env=-1;   /* negative control: the old path opens an extra clear-only pass */
+    uint8_t a3[256],b3[256]; uint64_t k3=g_clear_keep_n; uint64_t n3=run(1,a3,b3);
+    EXPECT("关闭（DM_NVN_CLEAR_KEEP=0）：不续挂",0,g_clear_keep_n-k3);
+    EXPECT("关闭：多一个只为清除的通道",n0+1,n3);
+    EXPECT("关闭：A 与基准逐字节相同",0,(uint64_t)(memcmp(a0,a3,256)!=0));
+    S.chmask.mask=15; id<MTLRenderPipelineState> base=pso_get(g_test_prog,nil);
+    uint32_t pso_before=g_pso.n;int same=1;
+    for(unsigned i=1;i<=64;i++){S.chmask.mask=15|(i<<16);if(pso_get(g_test_prog,nil)!=base)same=0;}
+    EXPECT("unused attachment write masks reuse the same actual Metal pipeline",1,same);
