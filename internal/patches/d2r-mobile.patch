+    EXPECT("再设同一目标：A 与基准逐字节相同",0,(uint64_t)(memcmp(a0,a1,256)!=0));
+    EXPECT("再设同一目标：B 与基准逐字节相同",0,(uint64_t)(memcmp(b0,b1,256)!=0));
