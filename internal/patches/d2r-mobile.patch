+#define COS_MAX 8
+static _Atomic uint64_t g_cos_lo[COS_MAX], g_cos_hi[COS_MAX];
+static struct { uint64_t sub, lo, hi, gpu; uint8_t *data; } g_cos_snap[COS_MAX];
