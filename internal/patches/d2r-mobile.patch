diff --git a/dm/gfx/nvn/nvn_adaptive_pace.h b/dm/gfx/nvn/nvn_adaptive_pace.h
new file mode 100644
index 0000000000000000000000000000000000000000..4859e2ec414b55765af9d1af075f80824b2d50fe
--- /dev/null
+++ b/dm/gfx/nvn/nvn_adaptive_pace.h
@@ -0,0 +1,31 @@
+// 自适应出图的整数分档与线程CPU统计；不改变 nvn_pace.h 的 Apple「至少60」策略。
+// Integer-divisor adaptive tiers and thread-CPU sampling; leaves nvn_pace.h's Apple "at least 60" policy unchanged.
+#pragma once
+#include <stdint.h>
+
+static inline int nvn_adaptive_min_divisor(double hz) {
+    double ratio = hz / 60.0;
+    int k = (int)ratio;
+    if (k < ratio) ++k;   // ceil：90Hz最高45帧，不能取floor而升到90。| ceil: at 90 Hz cap at 45 fps, never floor to 90.
+    return k > 0 ? k : 1;
+}
+static inline int nvn_adaptive_max_divisor(double hz) {
+    int k = (int)(hz / 20.0 + 0.02), lo = nvn_adaptive_min_divisor(hz);
+    return k < lo ? lo : k;
+}
+static inline int nvn_adaptive_divisor(double hz, int current, double old_hz) {
+    int lo = nvn_adaptive_min_divisor(hz), hi = nvn_adaptive_max_divisor(hz);
+    int k = current > 0 ? current : lo;
+    if (current > 0 && old_hz > 0 && hz != old_hz) k = (int)(current * hz / old_hz + 0.5);
+    return k < lo ? lo : k > hi ? hi : k;
+}
+
+// 输入必须是同一个线程的累计CPU纳秒；60帧窗与原图形负载统计一致，等待不会推进此时钟。
+// Input is cumulative CPU nanoseconds of the same thread. The 60-frame window matches existing graphics load statistics; waits do not advance this clock.
+typedef struct { uint64_t previous, sum; unsigned count; } nvn_frame_cpu_window;
+static inline int nvn_frame_cpu_sample(nvn_frame_cpu_window *s, uint64_t cpu_ns, double *ms) {
+    if (!s->previous || cpu_ns < s->previous) { s->previous = cpu_ns; s->sum = 0; s->count = 0; return 0; }
+    s->sum += cpu_ns - s->previous; s->previous = cpu_ns;
+    if (++s->count < 60) return 0;
+    *ms = s->sum / 60000000.0; s->sum = 0; s->count = 0; return 1;
+}
diff --git a/dm/gfx/nvn/nvn_copy_pitch.h b/dm/gfx/nvn/nvn_copy_pitch.h
new file mode 100644
index 0000000000000000000000000000000000000000..69b96fa9a8546129920d31b91a2815d7fdefba36
--- /dev/null
+++ b/dm/gfx/nvn/nvn_copy_pitch.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+// 两个方向共享字节间距；零表示紧排，在访问内存池前拒绝无效或溢出的范围。
+// Both copy directions use the same recorded byte strides. Zero selects tight
+static inline int nvn_copy_pitch(int width, int height, int depth, int bw, int bh,
+                                int bpb, int64_t row_stride, int64_t image_stride,
+                                size_t *row, size_t *image, size_t *extent) {
+    if (width <= 0 || height <= 0 || depth < 0 || bw <= 0 || bh <= 0 || bpb <= 0 ||
+        row_stride < 0 || image_stride < 0) return 0;
+    size_t blocks = ((size_t)width + bw - 1) / bw;
+    size_t rows = ((size_t)height + bh - 1) / bh;
+    if (blocks > SIZE_MAX / (size_t)bpb) return 0;
+    size_t tight = blocks * bpb;
+    *row = row_stride ? (size_t)row_stride : tight;
+    if (*row < tight || *row > SIZE_MAX / rows) return 0;
+    *image = image_stride ? (size_t)image_stride : *row * rows;
+    if (*image < *row * rows) return 0;
+    size_t layers = depth ? (size_t)depth : 1;
+    if (*image > SIZE_MAX / layers) return 0;
+    *extent = *image * layers;
+    return 1;
+}
