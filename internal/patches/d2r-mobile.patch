+    }
+    // 4. 水平硬边：离画面越远，过渡越宽 | 4. Hard horizontal edge: the transition is wider farther from the picture
+    {
+        int W = 868, H = 400, L = (W - 711) / 2;
+        uint8_t *p = present(picture(640, 360, paint_split), W, H);
+        int near = transition_rows(p, W, H, L - 2), far = transition_rows(p, W, H, L - 2 - L * 6 / 10);
+        EXPECT("紧邻处过渡至少 12 行（不是硬边）", near >= 12, "%d 行", near);
+        EXPECT("远处过渡宽于紧邻处 1.5 倍", far * 2 >= near * 3, "紧邻 %d 行，远处 %d 行", near, far);
+        free(p);
+    }
+    // 5. 光照图按线性光平均：棋盘格得 0.5（按显示值平均会得 0.22） | 5. The light map averages in linear light: a checkerboard gives 0.5 (an average of display values would give 0.22)
+    // 6. 跨帧混合：权重 0.25 连混两次白画面得 0.25、0.4375 | 6. Blend across frames: weight 0.25 twice with a white picture gives 0.25 and 0.4375
+    {
+        ambient_pipeline(MTLPixelFormatRGBA8Unorm);
+        id<MTLTexture> map = ambient_map_new();
+        float uv[8] = {0, 0, 1, 1, 0, 0, 1, 1};
+        ambient_uniforms u; ambient_fill(&u, 1, 1, (MTLViewport){0, 0, 1, 1, 0, 1}, uv, 0.8f, 1.0f);
+        id<MTLCommandBuffer> cb = [g_q commandBuffer]; ambient_map_m3(cb, picture(1024, 576, paint_checker), map, &u, 1); [cb commit]; [cb waitUntilCompleted];
+        float v = map_value(map, 10, 10);
+        EXPECT("棋盘格的光照图值", fabsf(v - 0.5f) < 0.02f, "%.4f", v);
+        id<MTLTexture> white = picture(256, 144, paint_white);
+        u.light[0] = 0.0f; cb = [g_q commandBuffer]; ambient_map_m3(cb, white, map, &u, 1); [cb commit]; [cb waitUntilCompleted];
+        EXPECT("清零后权重 0 的混合保持 0", map_value(map, 5, 5) == 0.0f, "%.4f", map_value(map, 5, 5));
+        u.light[0] = 0.25f;
+        cb = [g_q commandBuffer]; ambient_map_m3(cb, white, map, &u, 0); [cb commit]; [cb waitUntilCompleted];
+        float v1 = map_value(map, 5, 5);
+        cb = [g_q commandBuffer]; ambient_map_m3(cb, white, map, &u, 0); [cb commit]; [cb waitUntilCompleted];
+        float v2 = map_value(map, 5, 5);
+        EXPECT("第一次混合", fabsf(v1 - 0.25f) < 0.003f, "%.4f", v1);
+        EXPECT("第二次混合", fabsf(v2 - 0.4375f) < 0.003f, "%.4f", v2);
+    }
+    // 7. 16:9 全屏没有黑边，不画 | 7. Full 16:9 screen has no bars, nothing is drawn
+    {
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:320 height:180 mipmapped:NO];
+        d.usage = MTLTextureUsageRenderTarget;
+        id<MTLTexture> dst = [g_dev newTextureWithDescriptor:d];
+        float uv[8] = {0, 0, 1, 1, 0, 0, 1, 1}; ambient_uniforms u;
+        id<MTLCommandBuffer> cb = [g_q commandBuffer];
+        int n = ambient_prepare_m3(cb, picture(64, 36, paint_white), dst, (MTLViewport){0, 0, 320, 180, 0, 1}, uv, &u);
+        [cb commit]; [cb waitUntilCompleted];
+        EXPECT("全屏时黑边个数", n == 0, "%d", n);
+    }
+    // 8. 上屏路径（Metal 4）：黑变白时黑边按帧逐步变亮，8 帧内跟上；停顿 0.5 秒以上后直接换成当前画面
+    // 8. Present path (Metal 4): from black to white the bars brighten frame by frame and catch up within 8 frames; after a pause of more than
+    //    0.5 seconds they show the current picture at once
+    if (!g_q4) printf("没有 Metal 4 队列，跳过上屏路径\n");
+    else {
+        int W = 868, H = 400, L = (W - 711) / 2;
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:W height:H mipmapped:NO];
+        d.storageMode = MTLStorageModeShared; d.usage = MTLTextureUsageRenderTarget;
+        id<MTLTexture> dst = [g_dev newTextureWithDescriptor:d], white = picture(320, 180, paint_white), black = picture(320, 180, paint_black);
+        res_add(dst); res_add(white); res_add(black); res_commit();
+        id<MTLSharedEvent> ev = [g_dev newSharedEvent]; __block uint64_t serial = 0;
+        uint8_t *px = malloc((size_t)W * H * 4);
+        int (^frame)(id<MTLTexture>) = ^int(id<MTLTexture> src) {
+            int i = (int)(serial % 3);
+            [g_present_alloc4[i] reset];
+            id<MTL4CommandBuffer> cb = g_present_cb[i];
+            [cb beginCommandBufferWithAllocator:g_present_alloc4[i]];
+            if (!present_encode_m4(cb, src, dst, NULL, i)) { printf("M4 出图编码失败\n"); exit(1); }
+            [cb endCommandBuffer];
+            id<MTL4CommandBuffer> buffers[] = {cb};
+            [g_q4 commit:buffers count:1]; [g_q4 signalEvent:ev value:++serial];
+            if (![ev waitUntilSignaledValue:serial timeoutMS:5000]) { printf("M4 出图超时\n"); exit(1); }
+            [dst getBytes:px bytesPerRow:W * 4 fromRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0];
+            return luma((const uint8_t[3]){px[4 * (H / 2 * W + L - 1) + 2], px[4 * (H / 2 * W + L - 1) + 1], px[4 * (H / 2 * W + L - 1)]});
+        };
+        int v0 = frame(black), v[8], rising = 1;
+        for (int k = 0; k < 8; k++) { usleep(16667); v[k] = frame(white); if (k && v[k] < v[k - 1]) rising = 0; }
+        int bad = 0;
+        for (int y = 0; y < H; y++) for (int x = L + 1; x < L + 710; x++) bad += memcmp(px + 4 * (y * W + x), (const uint8_t[3]){255, 255, 255}, 3) != 0;
+        usleep(600000);
+        int snap = frame(white);
+        EXPECT("M4 首帧（黑画面）黑边为黑", v0 <= 3, "亮度 %d", v0);
+        EXPECT("M4 黑变白第一帧未直接到位", v[0] > 5 && v[0] <= snap - 12, "亮度 %d（稳定值 %d）", v[0], snap);
+        EXPECT("M4 逐帧变亮，8 帧内跟上（差 ≤ 5%）", rising && v[7] * 20 >= snap * 19, "亮度 %d → %d（稳定值 %d）", v[0], v[7], snap);
+        EXPECT("M4 画面像素不变", bad == 0, "不同像素 %d", bad);
+        EXPECT("M4 停顿后直接换成当前画面", snap >= 180 && snap <= 215, "亮度 %d", snap);
+        free(px);
+    }
+    printf("t_ambient：%d 项，失败 %d\n", count, fail);
+    return fail != 0;
+} }
diff --git a/dm/gfx/tests/t_clear_keep.m b/dm/gfx/tests/t_clear_keep.m
