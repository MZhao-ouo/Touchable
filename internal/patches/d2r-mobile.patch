+// 返回黑边矩形（最多两个）：上下黑边或左右黑边，二者只会出现一种；小于 2 像素的边不画。
+// Returns the bar rectangles (at most two): top/bottom or left/right bars, only one kind occurs; sides
+// thinner than 2 pixels are skipped.
+static int ambient_bar_rects(MTLViewport vp, NSUInteger dw, NSUInteger dh, MTLScissorRect out[2]) {
+    int n = 0;
+    if (vp.originY > 0.5) {
+        NSUInteger top = (NSUInteger)floor(vp.originY);
+        NSUInteger y1 = (NSUInteger)ceil(vp.originY + vp.height);
+        NSUInteger bottom = y1 < dh ? dh - y1 : 0;
+        if (top >= 2) out[n++] = (MTLScissorRect){0, 0, dw, top};
+        if (bottom >= 2) out[n++] = (MTLScissorRect){0, y1, dw, bottom};
