+// alpha：新光照图的混合权重（1 = 直接换成当前画面）。 | alpha: blend weight of the new light map (1 = replace it with the current picture).
+static void ambient_fill(ambient_uniforms *u, NSUInteger dw, NSUInteger dh, MTLViewport vp, const float uv[8], float gain, float alpha) {
+    memset(u, 0, sizeof *u);
+    u->rect[0] = (float)vp.originX; u->rect[1] = (float)vp.originY;
+    u->rect[2] = (float)vp.width; u->rect[3] = (float)vp.height;
+    memcpy(u->uv, uv, sizeof(float) * 4);
