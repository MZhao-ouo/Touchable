new file mode 100644
index 0000000000000000000000000000000000000000..77b82653d3f9f4f6bda18c24f1d81410b3571505
--- /dev/null
+++ b/dm/gfx/tests/t_ambient.m
@@ -0,0 +1,210 @@
+// 黑边光效回归：真实 Metal 渲染合成画面，按闭式性质检查（画面不变、颜色取自紧邻的画面边、向外单调变暗、
+// 离画面越远越模糊、线性光平均、跨帧混合）。-DSS_NVN_LOWER_LEFT_ORIGIN 编译时画面上下翻转，期望随之翻转。
+// Ambient bar regression: real Metal rendering of synthetic pictures, checked by closed-form properties
+// (picture unchanged, colour from the adjacent picture edge, monotonic fade outward, wider blur farther from the
+// picture, linear-light average, blend across frames). With -DSS_NVN_LOWER_LEFT_ORIGIN the picture is flipped
+// vertically, and the expectations flip with it.
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t g_mod[MAX_MOD]; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int fail, count;
+#define EXPECT(name, ok, fmt, ...) do { count++; printf("%s：" fmt " %s\n", name, __VA_ARGS__, (ok) ? "OK" : "FAIL"); if (!(ok)) fail++; } while (0)
+#ifdef SS_NVN_LOWER_LEFT_ORIGIN
+#define FLIP 1
+#else
+#define FLIP 0
+#endif
+
+typedef void (*painter)(int x, int y, int w, int h, uint8_t out[4]);
+static id<MTLTexture> picture(int w, int h, painter paint) {
+    MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:w height:h mipmapped:NO];
+    d.storageMode = MTLStorageModeShared; d.usage = MTLTextureUsageShaderRead;
+    id<MTLTexture> t = [g_dev newTextureWithDescriptor:d];
+    uint8_t *px = malloc((size_t)w * h * 4);
+    for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) { px[4 * (y * w + x) + 3] = 255; paint(x, y, w, h, px + 4 * (y * w + x)); }
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+// 出图到 w × h（RGBA8），返回像素；*vp 为画面所在矩形 | Present to w x h (RGBA8) and return the pixels; *vp is the picture rectangle
+static uint8_t *present(id<MTLTexture> src, int w, int h) {
+    MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:w height:h mipmapped:NO];
+    d.storageMode = MTLStorageModeShared; d.usage = MTLTextureUsageRenderTarget;
+    id<MTLTexture> dst = [g_dev newTextureWithDescriptor:d];
+    id<MTLCommandBuffer> cb = [g_q commandBuffer];
+    if (!present_encode(cb, src, dst, NULL)) { printf("出图编码失败\n"); exit(1); }
+    [cb commit]; [cb waitUntilCompleted];
+    if (cb.status != MTLCommandBufferStatusCompleted) { printf("GPU 未完成：%s\n", cb.error.description.UTF8String); exit(1); }
+    uint8_t *out = malloc((size_t)w * h * 4);
+    [dst getBytes:out bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+    return out;
+}
+static const uint8_t *at(const uint8_t *p, int w, int x, int y) { return p + 4 * (y * w + x); }
+static int luma(const uint8_t *c) { return (2126 * c[0] + 7152 * c[1] + 722 * c[2]) / 10000; }
+
+static void paint_flat(int x, int y, int w, int h, uint8_t o[4]) { (void)x; (void)y; (void)w; (void)h; o[0] = 200; o[1] = 60; o[2] = 30; }
+static void paint_white(int x, int y, int w, int h, uint8_t o[4]) { (void)x; (void)y; (void)w; (void)h; o[0] = o[1] = o[2] = 255; }
+static void paint_black(int x, int y, int w, int h, uint8_t o[4]) { (void)x; (void)y; (void)w; (void)h; o[0] = o[1] = o[2] = 0; }
+// 左 3% 绿、右 3% 蓝、其余红 | Left 3% green, right 3% blue, the rest red
+static void paint_sides(int x, int y, int w, int h, uint8_t o[4]) {
+    (void)y; (void)h; o[0] = o[1] = o[2] = 0;
+    if (x < w * 3 / 100) o[1] = 220; else if (x >= w - w * 3 / 100) o[2] = 220; else o[0] = 220;
+}
+// 上 3% 绿、下 3% 蓝、其余红（纹理行序） | Top 3% green, bottom 3% blue, the rest red (texture row order)
+static void paint_rows(int x, int y, int w, int h, uint8_t o[4]) {
+    (void)x; (void)w; o[0] = o[1] = o[2] = 0;
+    if (y < h * 3 / 100) o[1] = 220; else if (y >= h - h * 3 / 100) o[2] = 220; else o[0] = 220;
+}
+// 上半白、下半黑：一条水平硬边 | Top half white, bottom half black: one hard horizontal edge
+static void paint_split(int x, int y, int w, int h, uint8_t o[4]) { (void)x; (void)w; o[0] = o[1] = o[2] = y < h / 2 ? 255 : 0; }
+// 4 像素黑白棋盘格 | 4-pixel black and white checkerboard
+static void paint_checker(int x, int y, int w, int h, uint8_t o[4]) { (void)w; (void)h; o[0] = o[1] = o[2] = ((x / 4) ^ (y / 4)) & 1 ? 255 : 0; }
+
+// 一列中亮度在 10%..90% 之间的行数（过渡带宽度，与方向无关） | Rows of one column with a brightness between 10% and 90% (transition width, in either direction)
+static int transition_rows(const uint8_t *p, int w, int h, int x) {
+    int hi = 0, lo = 255, n = 0;
+    for (int y = 0; y < h; y++) { int v = luma(at(p, w, x, y)); if (v > hi) hi = v; if (v < lo) lo = v; }
+    int t90 = lo + (hi - lo) * 9 / 10, t10 = lo + (hi - lo) / 10;
+    for (int y = 0; y < h; y++) { int v = luma(at(p, w, x, y)); n += v > t10 && v < t90; }
+    return n;
+}
+static float half_to_float(uint16_t v) { _Float16 f; memcpy(&f, &v, 2); return (float)f; }
+static float map_value(id<MTLTexture> map, int x, int y) {
+    id<MTLBuffer> b = [g_dev newBufferWithLength:8 options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb = [g_q commandBuffer]; id<MTLBlitCommandEncoder> bl = [cb blitCommandEncoder];
+    [bl copyFromTexture:map sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(x, y, 0) sourceSize:MTLSizeMake(1, 1, 1) toBuffer:b destinationOffset:0 destinationBytesPerRow:8 destinationBytesPerImage:8];
+    [bl endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    return half_to_float(((uint16_t *)b.contents)[0]);
+}
+
+int main(void) { @autoreleasepool {
+    setenv("DM_NVN_AMBIENT_BARS", "0.8", 1);
+    mtl_init();
+    printf("== 黑边光效（%s）==\n", FLIP ? "左下原点" : "左上原点");
+
+    // 1. 画面像素不变；黑边有光 | 1. Picture pixels unchanged; the bars have light
+    {
+        int W = 868, H = 400, L = (W - 711) / 2;
+        uint8_t *p = present(picture(320, 180, paint_flat), W, H);
+        int bad = 0;
+        for (int y = 0; y < H; y++) for (int x = L + 1; x < L + 710; x++) { const uint8_t *c = at(p, W, x, y); bad += c[0] != 200 || c[1] != 60 || c[2] != 30; }
+        EXPECT("画面像素逐字节不变", bad == 0, "不同像素 %d", bad);
+        EXPECT("左黑边紧邻画面处有光", luma(at(p, W, L - 1, H / 2)) > 40, "亮度 %d", luma(at(p, W, L - 1, H / 2)));
+        free(p);
+    }
+    // 2. 颜色来自紧邻的画面边（旧版从画面内约 9% 处取样，会是红色） | 2. The colour comes from the adjacent picture edge (the old version sampled about 9% inside and gave red)
+    {
+        int W = 868, H = 400, L = (W - 711) / 2, R = L + 711;
+        uint8_t *p = present(picture(640, 360, paint_sides), W, H);
+        const uint8_t *l = at(p, W, L - 1, H / 2), *r = at(p, W, R, H / 2);
+        EXPECT("左黑边紧邻处以绿为主", l[1] > l[0] && l[1] > l[2], "RGB %d %d %d", l[0], l[1], l[2]);
+        EXPECT("右黑边紧邻处以蓝为主", r[2] > r[0] && r[2] > r[1], "RGB %d %d %d", r[0], r[1], r[2]);
+        free(p);
+    }
+    {
+        int W = 300, H = 200, T = (H - 169) / 2, B = T + 169;
+        uint8_t *p = present(picture(640, 360, paint_rows), W, H);
+        const uint8_t *t = at(p, W, W / 2, T - 1), *b = at(p, W, W / 2, B);
+        const uint8_t *green = FLIP ? b : t, *blue = FLIP ? t : b;
+        EXPECT("上下黑边：纹理首行一侧以绿为主", green[1] > green[0] && green[1] > green[2], "RGB %d %d %d", green[0], green[1], green[2]);
+        EXPECT("上下黑边：纹理末行一侧以蓝为主", blue[2] > blue[0] && blue[2] > blue[1], "RGB %d %d %d", blue[0], blue[1], blue[2]);
+        free(p);
+    }
+    // 3. 白画面：向外单调变暗，屏幕边缘接近黑；接缝台阶小，相邻列没有跳变 | 3. White picture: monotonic fade outward, near black at the screen edge; a small step at the seam, no jump between columns
+    {
+        int W = 2868, H = 1320, L = 260;   // iPhone 16 Pro Max
+        uint8_t *p = present(picture(320, 180, paint_white), W, H);
+        int rise = 0, prev = 255, jump = 0;
+        for (int x = L - 1; x >= 0; x--) { int v = luma(at(p, W, x, H / 2)); if (v > prev + 1) rise++; if (x < L - 1 && prev - v > jump) jump = prev - v; prev = v; }
+        int near = luma(at(p, W, L - 1, H / 2)), edge = luma(at(p, W, 0, H / 2));
+        EXPECT("向外不变亮（容差 1）", rise == 0, "变亮次数 %d", rise);
+        EXPECT("屏幕边缘接近黑", edge <= 3, "亮度 %d", edge);
+        EXPECT("紧邻处亮度在 180..215（接缝台阶 40..75）", near >= 180 && near <= 215, "亮度 %d", near);
+        EXPECT("黑边内相邻列亮度差 ≤ 4", jump <= 4, "最大差 %d", jump);
+        free(p);
+    }
+    // 4. 水平硬边：离画面越远，过渡越宽 | 4. Hard horizontal edge: the transition is wider farther from the picture
+    {
+        int W = 868, H = 400, L = (W - 711) / 2;
+        uint8_t *p = present(picture(640, 360, paint_split), W, H);
+        int near = transition_rows(p, W, H, L - 2), far = transition_rows(p, W, H, L - 2 - L * 6 / 10);
+        EXPECT("紧邻处过渡至少 12 行（不是硬边）", near >= 12, "%d 行", near);
+        EXPECT("远处过渡宽于紧邻处 1.5 倍", far * 2 >= near * 3, "紧邻 %d 行，远处 %d 行", near, far);
+        free(p);
+    }
+    // 5. 光照图按线性光平均：棋盘格得 0.5（按显示值平均会得 0.22） | 5. The light map averages in linear light: a checkerboard gives 0.5 (an average of display values would give 0.22)
+    // 6. 跨帧混合：权重 0.25 连混两次白画面得 0.25、0.4375 | 6. Blend across frames: weight 0.25 twice with a white picture gives 0.25 and 0.4375
+    {
+        ambient_pipeline(MTLPixelFormatRGBA8Unorm);
+        id<MTLTexture> map = ambient_map_new();
+        float uv[8] = {0, 0, 1, 1, 0, 0, 1, 1};
+        ambient_uniforms u; ambient_fill(&u, 1, 1, (MTLViewport){0, 0, 1, 1, 0, 1}, uv, 0.8f, 1.0f);
+        id<MTLCommandBuffer> cb = [g_q commandBuffer]; ambient_map_m3(cb, picture(1024, 576, paint_checker), map, &u, 1); [cb commit]; [cb waitUntilCompleted];
+        float v = map_value(map, 10, 10);
+        EXPECT("棋盘格的光照图值", fabsf(v - 0.5f) < 0.02f, "%.4f", v);
+        id<MTLTexture> white = picture(256, 144, paint_white);
+        u.light[0] = 0.0f; cb = [g_q commandBuffer]; ambient_map_m3(cb, white, map, &u, 1); [cb commit]; [cb waitUntilCompleted];
+        EXPECT("清零后权重 0 的混合保持 0", map_value(map, 5, 5) == 0.0f, "%.4f", map_value(map, 5, 5));
+        u.light[0] = 0.25f;
+        cb = [g_q commandBuffer]; ambient_map_m3(cb, white, map, &u, 0); [cb commit]; [cb waitUntilCompleted];
+        float v1 = map_value(map, 5, 5);
+        cb = [g_q commandBuffer]; ambient_map_m3(cb, white, map, &u, 0); [cb commit]; [cb waitUntilCompleted];
+        float v2 = map_value(map, 5, 5);
+        EXPECT("第一次混合", fabsf(v1 - 0.25f) < 0.003f, "%.4f", v1);
+        EXPECT("第二次混合", fabsf(v2 - 0.4375f) < 0.003f, "%.4f", v2);
+    }
+    // 7. 16:9 全屏没有黑边，不画 | 7. Full 16:9 screen has no bars, nothing is drawn
+    {
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:320 height:180 mipmapped:NO];
+        d.usage = MTLTextureUsageRenderTarget;
+        id<MTLTexture> dst = [g_dev newTextureWithDescriptor:d];
+        float uv[8] = {0, 0, 1, 1, 0, 0, 1, 1}; ambient_uniforms u;
+        id<MTLCommandBuffer> cb = [g_q commandBuffer];
+        int n = ambient_prepare_m3(cb, picture(64, 36, paint_white), dst, (MTLViewport){0, 0, 320, 180, 0, 1}, uv, &u);
+        [cb commit]; [cb waitUntilCompleted];
+        EXPECT("全屏时黑边个数", n == 0, "%d", n);
+    }
+    // 8. 上屏路径（Metal 4）：黑变白时黑边按帧逐步变亮，8 帧内跟上；停顿 0.5 秒以上后直接换成当前画面
+    // 8. Present path (Metal 4): from black to white the bars brighten frame by frame and catch up within 8 frames; after a pause of more than
+    //    0.5 seconds they show the current picture at once
+    if (!g_q4) printf("没有 Metal 4 队列，跳过上屏路径\n");
+    else {
+        int W = 868, H = 400, L = (W - 711) / 2;
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:W height:H mipmapped:NO];
+        d.storageMode = MTLStorageModeShared; d.usage = MTLTextureUsageRenderTarget;
+        id<MTLTexture> dst = [g_dev newTextureWithDescriptor:d], white = picture(320, 180, paint_white), black = picture(320, 180, paint_black);
+        res_add(dst); res_add(white); res_add(black); res_commit();
+        id<MTLSharedEvent> ev = [g_dev newSharedEvent]; __block uint64_t serial = 0;
+        uint8_t *px = malloc((size_t)W * H * 4);
+        int (^frame)(id<MTLTexture>) = ^int(id<MTLTexture> src) {
+            int i = (int)(serial % 3);
+            [g_present_alloc4[i] reset];
+            id<MTL4CommandBuffer> cb = g_present_cb[i];
+            [cb beginCommandBufferWithAllocator:g_present_alloc4[i]];
+            if (!present_encode_m4(cb, src, dst, NULL, i)) { printf("M4 出图编码失败\n"); exit(1); }
+            [cb endCommandBuffer];
+            id<MTL4CommandBuffer> buffers[] = {cb};
+            [g_q4 commit:buffers count:1]; [g_q4 signalEvent:ev value:++serial];
+            if (![ev waitUntilSignaledValue:serial timeoutMS:5000]) { printf("M4 出图超时\n"); exit(1); }
+            [dst getBytes:px bytesPerRow:W * 4 fromRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0];
+            return luma((const uint8_t[3]){px[4 * (H / 2 * W + L - 1) + 2], px[4 * (H / 2 * W + L - 1) + 1], px[4 * (H / 2 * W + L - 1)]});
+        };
+        int v0 = frame(black), v[8], rising = 1;
+        for (int k = 0; k < 8; k++) { usleep(16667); v[k] = frame(white); if (k && v[k] < v[k - 1]) rising = 0; }
+        int bad = 0;
+        for (int y = 0; y < H; y++) for (int x = L + 1; x < L + 710; x++) bad += memcmp(px + 4 * (y * W + x), (const uint8_t[3]){255, 255, 255}, 3) != 0;
+        usleep(600000);
+        int snap = frame(white);
+        EXPECT("M4 首帧（黑画面）黑边为黑", v0 <= 3, "亮度 %d", v0);
+        EXPECT("M4 黑变白第一帧未直接到位", v[0] > 5 && v[0] <= snap - 12, "亮度 %d（稳定值 %d）", v[0], snap);
+        EXPECT("M4 逐帧变亮，8 帧内跟上（差 ≤ 5%）", rising && v[7] * 20 >= snap * 19, "亮度 %d → %d（稳定值 %d）", v[0], v[7], snap);
+        EXPECT("M4 画面像素不变", bad == 0, "不同像素 %d", bad);
+        EXPECT("M4 停顿后直接换成当前画面", snap >= 180 && snap <= 215, "亮度 %d", snap);
+        free(px);
+    }
+    printf("t_ambient：%d 项，失败 %d\n", count, fail);
+    return fail != 0;
+} }
