+// 游戏适配层：把一个已实现的 NVN 函数换成包装，返回被换下的实现（包装照常调用它）。DM_NVN_PROF 开着时换计时包装背后的真实现，计时含包装
+// Game adapters: replace one implemented NVN function with a wrapper and return the replaced implementation (the wrapper calls it as usual). With DM_NVN_PROF on, the real implementation behind the timing wrapper is replaced, so the timing includes the wrapper
+static void nvn_nop(void);
+void *nvn_hook(const char *name, void *fn) {
+    nvn_init_slots();
+    for (unsigned i = 0; i < NVN_NFUNC; i++) {
+        if (strcmp(nvn_names[i], name)) continue;
+        void **slot = nvn_slot[i].fn == (void *)nvn_prof_entry ? &nvn_real[i] : &nvn_slot[i].fn;
+        void *old = *slot;
+        if (old == (void *)nvn_unimpl_entry || old == (void *)nvn_nop) die("NVN %s 没有语义实现，不能包装", name);
+        *slot = fn;
+        return old;
+    }
+    die("NVN 包装名 %s 不在 main 名字表里", name);
+    return NULL;
+}
