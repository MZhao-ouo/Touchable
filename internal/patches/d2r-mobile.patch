+}
+// 上屏路径的混合权重：按两次上屏的间隔折算；首帧或停顿 0.5 秒以上直接换成当前画面。
+// Blend weight of the present path, from the interval between two presents; the first frame or a pause of
+// more than 0.5 seconds replaces the light map with the current picture.
+static float ambient_alpha(void) {
+    static double last;
+    double now = CACurrentMediaTime(), dt = now - last;
+    last = now;
+    if (!(dt > 0.0) || dt > 0.5) return 1.0f;
+    return (float)(1.0 - exp(-dt / AMBIENT_TAU_S));
+}
+static id<MTLTexture> ambient_map_new(void) {
+    MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float width:AMBIENT_MAP_W height:AMBIENT_MAP_H mipmapped:NO];
+    d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead; d.storageMode = MTLStorageModePrivate;
+    id<MTLTexture> t = [g_dev newTextureWithDescriptor:d];
+    if (!t) MDIE("建立黑边光照图失败");
+    return t;
+}
+static void ambient_pipeline(MTLPixelFormat format) {
+    if (g_ambient_pso && g_ambient_fmt == format) return;
+    static const char *src_msl =
+        "#include <metal_stdlib>\nusing namespace metal;\n"
+        "struct V { float4 p [[position]]; };\n"
+        "struct A { float4 rect; float4 uv; float4 edge; float4 params; float4 light; };\n"
+        "constant float3 lum = float3(0.2126, 0.7152, 0.0722);\n"
+        "vertex V ambient_vs(uint id [[vertex_id]]) { float2 q = float2((id << 1) & 2, id & 2); V o; o.p = float4(q * float2(2, -2) + float2(-1, 1), 0, 1); return o; }\n"
